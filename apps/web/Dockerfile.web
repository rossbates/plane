# syntax=docker/dockerfile:1.7
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS base
ENV PNPM_HOME=/pnpm PATH="/pnpm:$PATH" TURBO_TELEMETRY_DISABLED=1
RUN corepack enable
WORKDIR /app

FROM base AS dependencies
RUN apk add --no-cache libc6-compat
# Use the full, frozen workspace graph. Turbo's pruned lockfiles do not preserve
# all injected-workspace peer snapshots with this pnpm release.
COPY . .
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    CI=true pnpm install --frozen-lockfile --store-dir=/pnpm/store

FROM dependencies AS installer
# Public relative URLs make one image reusable across private installations.
ARG VITE_API_BASE_URL=""
ARG VITE_ADMIN_BASE_URL=""
ARG VITE_ADMIN_BASE_PATH="/god-mode"
ARG VITE_LIVE_BASE_URL=""
ARG VITE_LIVE_BASE_PATH="/live"
ARG VITE_SPACE_BASE_URL=""
ARG VITE_SPACE_BASE_PATH="/spaces"
ARG VITE_WEB_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_ADMIN_BASE_URL=$VITE_ADMIN_BASE_URL VITE_ADMIN_BASE_PATH=$VITE_ADMIN_BASE_PATH \
    VITE_LIVE_BASE_URL=$VITE_LIVE_BASE_URL VITE_LIVE_BASE_PATH=$VITE_LIVE_BASE_PATH \
    VITE_SPACE_BASE_URL=$VITE_SPACE_BASE_URL VITE_SPACE_BASE_PATH=$VITE_SPACE_BASE_PATH \
    VITE_WEB_BASE_URL=$VITE_WEB_BASE_URL
RUN pnpm turbo run build --filter=web && pnpm --filter=web check:types

FROM nginx:1.31-alpine@sha256:df221db836e1754089190208cee7eeda94f233197056426eda74a43ab1abeac2 AS runtime
RUN apk add --no-cache curl && apk upgrade --no-cache \
    && chown -R nginx:nginx /var/cache/nginx
COPY apps/web/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --from=installer /app/apps/web/build/client /usr/share/nginx/html
USER nginx
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3000/ >/dev/null || exit 1
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]

FROM installer AS checks
CMD ["pnpm", "--filter", "web", "test"]
