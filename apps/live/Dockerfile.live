# syntax=docker/dockerfile:1.7
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS base
ENV PNPM_HOME=/pnpm PATH="/pnpm:$PATH" TURBO_TELEMETRY_DISABLED=1
RUN corepack enable
WORKDIR /app

FROM base AS dependencies
RUN apk add --no-cache libc6-compat
COPY . .
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    CI=true pnpm install --frozen-lockfile --store-dir=/pnpm/store

FROM dependencies AS installer
RUN pnpm turbo run build --filter=live
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm --filter=live deploy --prod --offline --store-dir=/pnpm/store /runtime/live

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=installer --chown=node:node /runtime/live ./apps/live
# Package managers and their bundled dependencies are build-only.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /pnpm
USER node
EXPOSE 3000
CMD ["node", "apps/live"]

FROM installer AS checks
CMD ["pnpm", "--filter", "live", "test"]
