# syntax=docker/dockerfile:1.7
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS base
ENV PNPM_HOME=/pnpm PATH="/pnpm:$PATH" TURBO_TELEMETRY_DISABLED=1
RUN corepack enable
WORKDIR /app

FROM base AS dependencies
RUN apk add --no-cache libc6-compat
COPY . .
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    CI=true pnpm install --frozen-lockfile --store-dir=/pnpm/store

FROM dependencies AS installer
ARG VITE_API_BASE_URL=""
ARG VITE_API_BASE_PATH="/api"
ARG VITE_ADMIN_BASE_URL=""
ARG VITE_ADMIN_BASE_PATH="/god-mode"
ARG VITE_SPACE_BASE_URL=""
ARG VITE_SPACE_BASE_PATH="/spaces"
ARG VITE_LIVE_BASE_URL=""
ARG VITE_LIVE_BASE_PATH="/live"
ARG VITE_WEB_BASE_URL=""
ARG VITE_WEB_BASE_PATH=""
ARG VITE_WEBSITE_URL="https://plane.so"
ARG VITE_SUPPORT_EMAIL="support@plane.so"
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL VITE_API_BASE_PATH=$VITE_API_BASE_PATH \
    VITE_ADMIN_BASE_URL=$VITE_ADMIN_BASE_URL VITE_ADMIN_BASE_PATH=$VITE_ADMIN_BASE_PATH \
    VITE_SPACE_BASE_URL=$VITE_SPACE_BASE_URL VITE_SPACE_BASE_PATH=$VITE_SPACE_BASE_PATH \
    VITE_LIVE_BASE_URL=$VITE_LIVE_BASE_URL VITE_LIVE_BASE_PATH=$VITE_LIVE_BASE_PATH \
    VITE_WEB_BASE_URL=$VITE_WEB_BASE_URL VITE_WEB_BASE_PATH=$VITE_WEB_BASE_PATH \
    VITE_WEBSITE_URL=$VITE_WEBSITE_URL VITE_SUPPORT_EMAIL=$VITE_SUPPORT_EMAIL
RUN pnpm turbo run build --filter=space && pnpm --filter=space check:types
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm --filter=space deploy --prod --offline --store-dir=/pnpm/store /runtime/space

FROM base AS runtime
ENV NODE_ENV=production
RUN apk add --no-cache curl
COPY --from=installer --chown=node:node /runtime/space ./apps/space
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /pnpm
WORKDIR /app/apps/space
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3000/spaces/ >/dev/null || exit 1
CMD ["node", "node_modules/@react-router/serve/bin.js", "./build/server/index.js"]
