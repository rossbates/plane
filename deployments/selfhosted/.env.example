# Reference only: copy to protected storage OUTSIDE the public checkout.
# Replace every placeholder. Never commit the resulting environment file.
APP_DOMAIN=plane.example.com
WEB_URL=https://plane.example.com
PLANE_IMAGE_OWNER=your-github-owner
PLANE_IMAGE_TAG=sha-replace-with-a-successfully-published-full-commit-sha
# 0 preserves upstream UI; 1 hides only Community/GitHub/Billing promotions.
HIDE_PROMOTIONAL_UI=0
# Generate independent strong values (e.g. openssl rand -hex 32).
POSTGRES_PASSWORD=replace-before-deploying
RABBITMQ_PASSWORD=replace-before-deploying
SECRET_KEY=replace-before-deploying
LIVE_SERVER_SECRET_KEY=replace-before-deploying
AWS_ACCESS_KEY_ID=replace-before-deploying
AWS_SECRET_ACCESS_KEY=replace-before-deploying
